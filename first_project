    def get_display_name(self, lat, lon):
        try:
            response = location_client.search_place_index_for_position(
                IndexName=INDEX_NAME,
                Position=[lon, lat],  # AWS expects Longitude first
                Language="en",  # Force response in English
                MaxResults=5  # Get more detailed results
            )
            results = response.get('Results', [])
            if results:
                # Extract multiple components to form a detailed address
                place = results[0]['Place']
                components = [
                    place.get('Street', ''),  # Street address (if available)
                    place.get('Neighborhood', ''),  # Neighborhood
                    place.get('Municipality', ''),  # City/District
                    place.get('Region', ''),  # State/Province
                    place.get('Country', '')  # Country
                ]
                # Filter out empty components and join
                return ", ".join(filter(None, components))
            else:
                return "No address found"
        except Exception as e:
            return f"Error fetching address: {e}"


    def process_with_throttling(self, df, max_workers=10, delay=0.2):
        results = []
        unique_coords = df[['Latitude', 'Longtitude']].drop_duplicates()
        coord_to_address = {}

        with ThreadPoolExecutor(max_workers=max_workers) as executor:
            future_to_coord = {
                executor.submit(self.get_display_name, lat, long): (lat, long)
                for lat, long in unique_coords.to_numpy()
            }
            
            for future in as_completed(future_to_coord):
                lat, long = future_to_coord[future]
                try:
                    address = future.result()
                except Exception as exc:
                    address = "Error fetching address"
                
                coord_to_address[(lat, long)] = address
                time.sleep(delay)  # Throttling for API rate limits

        df["address"] = df.apply(lambda row: coord_to_address[(row["Latitude"], row["Longtitude"])], axis=1)
        return df["address"]


    def snap_to_roads(self,api_key, df, batch_size=95):
        base_url = "https://roads.googleapis.com/v1/snapToRoads"
        

        # Initialize new columns
        df["new_latitude"] = None
        df["new_longitude"] = None

        # Process in batches
        for i in range(0, len(df), batch_size):
            batch_df = df.iloc[i:i + batch_size]
            print(f"Processing batch {i // batch_size + 1}, Sending {len(batch_df)} points")

            # API request logic here (as in your original code)
            points = list(zip(batch_df['Latitude'], batch_df['Longtitude']))
            path = "|".join([f"{lat},{lng}" for lat, lng in points])
            params = {"path": path, "interpolate": "true", "key": api_key}
            response = requests.get(base_url, params=params)
            response_json = response.json()

            if "snappedPoints" in response_json:
                snapped_points = response_json["snappedPoints"]
                snapped_dict = {p["originalIndex"]: (p["location"]["latitude"], p["location"]["longitude"]) 
                                for p in snapped_points if "originalIndex" in p}

                # Assign snapped values
                for idx, (lat, lng) in snapped_dict.items():
                    df.at[i + idx, "new_latitude"] = lat  # Adjust index
                    df.at[i + idx, "new_longitude"] = lng

        # Handle missing values by retrying each missing point separately
        missing_indices = df[df["new_latitude"].isna()].index
        if len(missing_indices) > 0:
            print(f"Retrying API for {len(missing_indices)} missing points...")
            for idx in missing_indices:
                lat, lng = df.at[idx, "latitude"], df.at[idx, "longitude"]
                single_point_url = f"{base_url}?path={lat},{lng}&key={api_key}"
                single_response = requests.get(single_point_url).json()

                if "snappedPoints" in single_response:
                    snapped = single_response["snappedPoints"][0]["location"]
                    df.at[idx, "new_latitude"] = snapped["latitude"]
                    df.at[idx, "new_longitude"] = snapped["longitude"]

        # Fill remaining missing values using forward-fill and backward-fill
        df["new_latitude"] = df["new_latitude"].ffill()  # Forward fill
        df["new_latitude"] = df["new_latitude"].bfill()  # Backward fill
        df["new_longitude"] = df["new_longitude"].ffill()  # Forward fill
        df["new_longitude"] = df["new_longitude"].bfill()  # Backward fill

        return df


