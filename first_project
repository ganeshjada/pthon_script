    def __init__(self, env):
        user_path = '/fleet/' + env
        ps = ParamStore()
        auth = ps.read_param_store(user_path)
        
        self.mySql_host = auth['mysql-host']
        self.mySql_User = auth['mysql-user']
        self.mySql_Password = auth['mysql-password']
        self.mySql_Db = auth['mysql-db']

    def WriteToMySql(self, Df, TableName):
        database_connection = sqlalchemy.create_engine('mysql+mysqlconnector://{0}:{1}@{2}/{3}'.
                                                    format(self.mySql_User, self.mySql_Password,
                                                            self.mySql_host, self.mySql_Db))
        Df.to_sql(con=database_connection, name=TableName, if_exists='append', index=False)
        
  

