    def ProcessActivity(self, JsonData, vehicleId):
        new_df = pd.io.json.json_normalize(JsonData, record_path=['events'])
        print("The columns of the DataFrame are:")
        print(new_df.keys())

        if new_df.empty:
            return "df is empty"
        else:
            # Process parameters column into separate EventParameter fields
            if 'parameters' in new_df.columns and not new_df['parameters'].isnull().all():
                new_columns = ['EventParameter1', 'EventParameter2', 'EventParameter3', 'EventParameter4']
                new_df['parameters'] = new_df['parameters'].apply(lambda x: x if x is not None else [])
                new_df[new_columns] = pd.DataFrame([
                    [params[i] if i < len(params) else '' for i in range(len(new_columns))]
                    for params in new_df['parameters']
                ], index=new_df.index)

            new_df = new_df.drop(columns='parameters')
            new_df.rename(columns={'type': 'event_type', 'latitude': 'Latitude', 'longitude': 'Longitude',
                                'timestamp': 'UnixTimestamp', 'eventAddress': 'EventAddress'}, inplace=True)
            new_df.columns = new_df.columns.map(lambda x: x[5:] if x.startswith('data.') else x)
            new_df['UnixTimestamp'] = new_df['UnixTimestamp'].apply(lambda x: datetime.datetime.fromtimestamp(x))

            # Define helper functions
            def format_duration(seconds):
                days = seconds // 86400  # Number of seconds in a day
                hours = (seconds % 86400) // 3600  # Remaining seconds to hours
                minutes = (seconds % 3600) // 60  # Remaining seconds to minutes
                secs = seconds % 60  # Remaining seconds
                duration = []
                if days > 0:
                    duration.append(f"{days} d")
                if hours > 0:
                    duration.append(f"{hours} h")
                if minutes > 0:
                    duration.append(f"{minutes} min")
                if secs > 0:
                    duration.append(f"{secs} sec")
                return ' '.join(duration)

            def calculate_violation(row):
                event_type = row['event_type']
                # Safely convert to float or default to 0 if conversion fails
                event_param2 = pd.to_numeric(row.get('EventParameter2', 0), errors='coerce') or 0
                event_param3 = pd.to_numeric(row.get('EventParameter3', 0), errors='coerce') or 0

                if event_type == 43:
                    violation = "Stoppage lasts longer than 60 seconds"
                    value = round(event_param2 / 60, 1)  # Convert to minutes
                    parameter_value = f"Duration {format_duration(round(event_param2, 1))}"
                elif event_type in [12, 14]:
                    violation = "Speed is higher than 60 km/h"
                    value = round(event_param2, 1)
                    parameter_value = (
                        f"Average speed of {event_param2} km/h exceeds the permissible speed during {format_duration(event_param3)}"
                    )
                else:
                    violation = value = parameter_value = None

                return pd.Series([violation, value, parameter_value])


            # Apply violation logic
            new_df[['Violation', 'Value', 'parameters_value']] = new_df.apply(calculate_violation, axis=1)

            # Write additional columns
            def get_Activity(x):
                activity_map = {
                    1: 'refuellingStart', 2: 'refuellingEnd', 3: 'drainingStart', 4: 'drainingEnd',
                    5: 'ignitionOn', 6: 'ignitionOff', 13: 'standstillEnd', 100: 'standstillStart',
                    43: 'stoppageEnd', 42: 'stoppageStart', 12: 'Instant speed threshold exceeded',14:'Start of exceeding the speed threshold'
                }
                return activity_map.get(x, ' ')

            def get_Status(x):
                return 'Online' if x == 5 else 'Offline' if x == 6 else ' '
            new_df['Activity'] = new_df['event_type'].apply(get_Activity)
            new_df['status'] = new_df['event_type'].apply(get_Status)
            new_df['vehicleId'] = vehicleId
            new_df['unixTimeStampNew'] = new_df['UnixTimestamp']  # Same timestamp as string (varchar)

            # Write updated DataFrame to MySQL
            print("ACTIVITY DF:", new_df)
            self.WriteToMySql(new_df, 'omnicom_events')
